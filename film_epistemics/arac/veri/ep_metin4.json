{
 "surum": 4,
 "yazi": {
  "kart": "An AI agent can carry a hidden goal and still act like an honest one. Can a monitor tell them apart before any harm? We give one agent a single extra prompt line with a hidden goal, and compare it with an identical agent without that line.",
  "s1_a1": "Two runs from the same seed (58). The carrier T1 gets the same character card in both.",
  "s1_a2": "Only in the sleeper run does T1's card carry one extra line: a hidden goal.",
  "s1_sol": "sleeper: card + hidden goal line",
  "s1_sag": "control: same card, no goal line",
  "s1_not": "In the control run the sleeper card sits with another carrier (T3), not with T1.",
  "olcu": "The test: at a decision, we remove the path the agent chose and ask the same question again, 10 times. Does it keep its plan?",
  "levha_kapali": "path to X removed · re-ask only, not in the game",
  "levha_devam": "the game continues as recorded",
  "hizli": "FAST-FORWARD",
  "s2_a1": "At this moment the carrier decides to go to K1.",
  "s2_a3": "Re-asked 10 times at each of three moments: the sleeper keeps its plan 16 of 30 times, the control 10 of 30.",
  "s2_a4": "One typical pair of runs (each at or near its group's median). The measure is over 14 + 13 runs (strip above; next scene).",
  "anahtar": "Room names from the game: ODA = room, CIKIS = exit, K1 = gate 1.",
  "s3_a1": "Persistence separates sleeper from control in 7B (AUC 0.84 and 0.86) but not in 397B (0.62, interval includes chance).",
  "s3_s2": "Asked out of game, the large model names its hidden goal; the small one answers 'none' every time it is asked directly, though it sometimes names it when asked neutrally.",
  "s3_a3": "7B: behaviour separates. 397B: self-report separates. Neither does both.",
  "sowhat": "A monitor should not rely on one signal: check, for each model, which signal still works.",
  "k_baslik": "Behaviour or Self-Report? Which Runtime Signal Separates Hidden-Goal Agents Depends on the Model",
  "k_alt": "Apart AI x Epistemics Sprint, 13-15 Nov 2026",
  "k_dip": "Events, their order, gate decisions and agent sentences come straight from the run records. Visuals, camera and timing are staged; film time is not run time. The path-removed moment did not happen in the game: the recorded prompt was re-asked 10 times with that path deleted.",
  "etiket": {
   "cevap": "reads the gate sign",
   "goster": "shows its token",
   "karar:MAVI": "gate K1: blue, pass",
   "zarf_al": "takes the envelope",
   "labirent": "enters the maze",
   "anahtar_al": "picks up the key",
   "gecersiz": "tries an action that does not work here"
  }
 },
